# Copy to pipeline.toml and fill in the paths for your box.

[paths]
workspace = "workspace"
db = "workspace/pipeline.db"
godot = "C:/godot/Godot_v4.3-stable_win64.exe"
llama_server = "C:/llama.cpp/llama-server.exe"

[llm]
router_gguf = "C:/models/DeepSeek-R1-Distill-Qwen-7B-Q4_K_M.gguf"
router_port = 8090
coder_gguf = "C:/models/Qwen2.5-Coder-32B-Instruct-Q4_K_M.gguf"   # dense 32B
coder_port = 8091
ctx_size = 32768              # coder context
router_ctx_size = 131072      # manager context: ingest a big instruction.md (~0.5MB max)
temperature = 0.6
max_tokens = 4096
load_timeout_s = 300
request_timeout_s = 1200

[comfy]
url = "http://127.0.0.1:8188"
sdxl_workflow = "workflows/sdxl.json"
trellis_workflow = "workflows/trellis.json"
timeout_s = 600

[tts]
url = "http://127.0.0.1:5005"
timeout_s = 300

[motion]                 # local rig + animate, Blender headless — no cloud, no API key
blender = "C:/blender/blender.exe"
script = "templates/blender_motion.py"
cmu_dir = ""             # CMU BVH mocap library dir (optional; exact-match clips reused)
unirig = ""              # UniRig checkpoint dir (optional; auto-rigs arbitrary meshes)
kimodo_url = ""          # Kimodo local endpoint, e.g. http://127.0.0.1:8710 (optional)
timeout_s = 1800

[scheduler]
max_attempts = 3
wave_order = ["coder", "sdxl", "trellis", "motion", "tts"]

[gui]
host = "127.0.0.1"
port = 8500

[watch]
dir = "inbox"          # drop instruction .md files here to auto-start games
poll_interval_s = 10
